    "expected_keywords": ["household", "member", "chore", "swap", "reward", "flatmates", "families", "couples"],
    "assertions": [
      {"type": "contains_all", "values": ["household", "member", "chore", "swap", "reward"]},
      {"type": "contains_any", "values": ["flatmate", "flatmates", "roommates"]}
    ]
  },
