FROM golang:1.22-alpine

WORKDIR /app

# Install git, certificates, curl and air live-reloader
RUN apk add --no-cache git ca-certificates tzdata curl && \
    curl -sSfL https://raw.githubusercontent.com/air-verse/air/master/install.sh | sh -s -- -b /go/bin v1.52.3

# Cache Go dependencies
COPY go.mod go.sum* ./
RUN go mod download || true

# Copy source code
COPY . .

ENV PORT=8000
EXPOSE 8000

# Start with Air live-reload
CMD ["air", "-c", ".air.toml"]
