#!/usr/bin/env bash
set -euo pipefail

# ChoreSync On-Call: Trigger Test Incident
# Simulates a burst of 500 errors against the backend and triggers the on-call alert receiver.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ON_CALL_DIR="$(dirname "$SCRIPT_DIR")"
BASE_URL="${API_BASE_URL:-http://localhost:8000}"

echo "=== [ON-CALL] Triggering Synthetic Test Incident: HighHttpErrorRate ==="

# 1. Generate burst of synthetic HTTP 500 errors on the live backend
echo "1. Generating synthetic 500 errors via $BASE_URL/api/v1/dev/simulate-error..."
for i in {1..10}; do
  curl -s -X POST "$BASE_URL/api/v1/dev/simulate-error" > /dev/null 2>&1 || true
done

# Also generate a few normal requests to create a realistic ratio
for i in {1..5}; do
  curl -s "$BASE_URL/api/v1/households" > /dev/null 2>&1 || true
done

echo "Synthetic traffic generated (10 failures, 5 successes)."

# 2. Wait 3 seconds for OpenTelemetry metric collection batch
sleep 3

# 3. Construct the alert payload
ALERT_PAYLOAD='{
  "alert": {
    "name": "HighHttpErrorRate",
    "state": "firing",
    "severity": "critical"
  },
  "service": {
    "name": "api-backend",
    "version": "dev-latest"
  },
  "deployment": {
    "environment": "development"
  },
  "metric": {
    "name": "choresync_http_requests_total",
    "observed_value": 66.67,
    "threshold": 5.0,
    "duration": "1m"
  },
  "dashboard_url": "http://localhost:3001/d/overview?var-environment=development",
  "runbook_url": "on-call-engineer/runbook.md#high-http-error-rate",
  "timestamp": "'$(date -u +"%Y-%m-%dT%H:%M:%SZ")'"
}'

# 4. Ingest alert into on-call receiver
echo "2. Delivering normalized alert to on-call receiver..."
bash "$SCRIPT_DIR/receive-alert" <<< "$ALERT_PAYLOAD"

echo "=== [ON-CALL] Test Incident Triggered Successfully ==="
