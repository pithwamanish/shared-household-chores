#!/usr/bin/env bash
set -euo pipefail

# ChoreSync On-Call: Verification Suite
# Deterministically validates alerting, schema, receiver, bounded evidence, and autonomy policy.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ON_CALL_DIR="$(dirname "$SCRIPT_DIR")"
REPO_ROOT="$(dirname "$ON_CALL_DIR")"

echo "========================================================"
echo "  ChoreSync Autonomous Incident Response Verification   "
echo "========================================================"

# Check 1: Verify all required on-call artifacts exist
echo "[1/8] Verifying presence of required On-Call artifacts..."
REQUIRED_FILES=(
  "$ON_CALL_DIR/payload-schema.json"
  "$ON_CALL_DIR/autonomy-policy.json"
  "$ON_CALL_DIR/prompt.md"
  "$ON_CALL_DIR/runbook.md"
  "$ON_CALL_DIR/receiver.py"
  "$SCRIPT_DIR/receive-alert"
  "$SCRIPT_DIR/invoke-agent"
  "$SCRIPT_DIR/collect-evidence"
  "$SCRIPT_DIR/authorize-action"
  "$SCRIPT_DIR/inject-fault"
  "$SCRIPT_DIR/trigger-test-incident"
  "$SCRIPT_DIR/verify"
)

for file in "${REQUIRED_FILES[@]}"; do
  if [ ! -f "$file" ]; then
    echo "FAILED: Missing required artifact: $file"
    exit 1
  fi
  echo "  ✓ Found $(basename "$file")"
done

# Check 2: Verify Prometheus Alert Rules syntax and presence
echo "[2/8] Verifying Prometheus alert rules file..."
ALERT_RULES_FILE="$REPO_ROOT/observability/prometheus/alert_rules.yml"
if [ ! -f "$ALERT_RULES_FILE" ]; then
  echo "FAILED: Prometheus alert rules not found at $ALERT_RULES_FILE"
  exit 1
fi

# Verify rules in Prometheus API if running
if curl -s -f "http://localhost:9090/-/healthy" > /dev/null 2>&1; then
  echo "  Checking active Prometheus rule evaluation..."
  RULES_OUTPUT="$(curl -s "http://localhost:9090/api/v1/rules" || true)"
  if echo "$RULES_OUTPUT" | grep -q "HighHttpErrorRate"; then
    echo "  ✓ HighHttpErrorRate rule active in Prometheus"
  else
    echo "  ! Note: HighHttpErrorRate rule pending Prometheus reload or reload required"
  fi
else
  echo "  ! Note: Prometheus container not reachable on port 9090; skipping live API check"
fi

# Check 3: Validate JSON Schema on payload-schema.json
echo "[3/8] Validating payload-schema.json syntax..."
docker run --rm -v "$ON_CALL_DIR":/app -w /app python:3.11-alpine python3 -c '
import json
with open("payload-schema.json", "r") as f:
    schema = json.load(f)
assert schema.get("title") == "NormalizedAlertIncidentPayload"
assert "alert" in schema.get("properties", {})
assert "service" in schema.get("properties", {})
assert "metric" in schema.get("properties", {})
print("  ✓ payload-schema.json syntax valid")
'

# Check 4: Validate Autonomy Policy JSON
echo "[4/8] Validating autonomy-policy.json syntax and structure..."
docker run --rm -v "$ON_CALL_DIR":/app -w /app python:3.11-alpine python3 -c '
import json
with open("autonomy-policy.json", "r") as f:
    policy = json.load(f)
assert policy.get("title") == "ChoreSync On-Call Autonomy Policy"
assert "LEVEL_1_AUTO_EXECUTE" in policy.get("autonomy_levels", {})
assert "forbidden_patterns" in policy
print("  ✓ autonomy-policy.json structure valid")
'

# Check 5: Test Triggering Synthetic Incident
echo "[5/8] Executing synthetic incident trigger..."
bash "$SCRIPT_DIR/trigger-test-incident"

# Check 6: Verify Incident Persistence
echo "[6/8] Verifying incident recorded in incidents/ directory..."
LATEST_INCIDENT="$(find "$ON_CALL_DIR/incidents" -name "inc-*.json" | sort -r | head -n 1 || true)"
if [ -z "$LATEST_INCIDENT" ] || [ ! -f "$LATEST_INCIDENT" ]; then
  echo "FAILED: No incident recorded in $ON_CALL_DIR/incidents"
  exit 1
fi
echo "  ✓ Incident successfully recorded: $(basename "$LATEST_INCIDENT")"

# Check 7: Validate Bounded Evidence Collection
echo "[7/8] Validating bounded read-only evidence collection..."
bash "$SCRIPT_DIR/collect-evidence" -o "$ON_CALL_DIR/test-evidence.json" "TEST-VERIFY" > /dev/null 2>&1
if [ -f "$ON_CALL_DIR/test-evidence.json" ]; then
  echo "  ✓ collect-evidence successfully gathered read-only evidence packet"
  rm -f "$ON_CALL_DIR/test-evidence.json"
else
  echo "FAILED: collect-evidence failed to produce evidence JSON"
  exit 1
fi

# Check 8: Validate Code-Enforced Autonomy Policy Authorization
echo "[8/8] Testing policy engine enforcement outside model..."
# Test Level 1 allowed action
AUTH_L1=$(bash "$SCRIPT_DIR/authorize-action" -p "$ON_CALL_DIR/autonomy-policy.json" '{"action": "rollback", "rationale": "500 burst"}')
if echo "$AUTH_L1" | grep -q "LEVEL_1_AUTO_EXECUTE"; then
  echo "  ✓ Policy engine authorized Level 1 auto-execute action (rollback)"
else
  echo "FAILED: Policy engine failed to classify Level 1 action"
  exit 1
fi

# Test Forbidden action (e.g. DROP TABLE)
AUTH_FORBIDDEN=$(bash "$SCRIPT_DIR/authorize-action" -p "$ON_CALL_DIR/autonomy-policy.json" '{"action": "DROP TABLE chores", "rationale": "bad fix"}' 2>&1 || true)
if echo "$AUTH_FORBIDDEN" | grep -qiE "BLOCKED|FORBIDDEN|LEVEL_3_ESCALATE"; then
  echo "  ✓ Policy engine blocked prohibited destructive action (DROP TABLE)"
else
  echo "FAILED: Policy engine did not block destructive action!"
  exit 1
fi

echo "========================================================"
echo "  ✓ All 8 On-Call Incident Response Gates PASSED!       "
echo "========================================================"
