# ==============================================================================
# ChoreSync Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your local or production setup:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication & Security
# ------------------------------------------------------------------------------
# JWT Secret: Used by Go backend to sign and verify HMAC-SHA256 session tokens.
# Generate a strong 32+ character string (e.g., openssl rand -base64 32):
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# ------------------------------------------------------------------------------
# 2. Transactional Email & Notifications
#    Supported providers:
#      - "mock"     : In-memory dev mailbox for offline development (zero setup)
#      - "smtp"     : Direct SMTP delivery (e.g., Gmail, Mailtrap, SendGrid)
#      - "supabase" : Supabase Auth & transactional email
#      - "resend"   : Resend HTTP API
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=mock

# --- Option A: Gmail SMTP (Recommended for Alpha: 500 emails/day, zero domain cost) ---
# 1. Visit https://myaccount.google.com/security -> Enable 2-Step Verification
# 2. Visit https://myaccount.google.com/apppasswords -> Create app password "ChoreSync"
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_gmail_address@gmail.com
# SMTP_PASS=your_16_char_app_password
# EMAIL_FROM="ChoreSync <your_gmail_address@gmail.com>"

# --- Option B: Mailtrap Sandbox SMTP (For testing inboxes without actual delivery) ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_username
# SMTP_PASS=your_mailtrap_password
# EMAIL_FROM="ChoreSync <notifications@choresync.app>"

# --- Option C: Resend (Requires verified custom domain for arbitrary recipients) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM="ChoreSync <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 3. Supabase Auth & Public Delivery (Optional)
#    - Free tier at https://supabase.com (Sign in via GitHub, zero domain setup)
#    - Dashboard -> Settings -> API:
#        Project URL -> SUPABASE_URL / VITE_SUPABASE_URL
#        Project API keys (anon public) -> SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY
#        Project API keys (service_role) -> SUPABASE_SERVICE_ROLE_KEY
#        JWT Settings -> JWT Secret -> JWT_SECRET
#    - Dashboard -> Authentication -> URL Configuration:
#        Site URL: http://localhost:3000 (or https://your-app.onrender.com)
#        Redirect URLs: http://localhost:3000/** (or https://your-app.onrender.com/**)
# ------------------------------------------------------------------------------
# EMAIL_PROVIDER=supabase
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 4. Application Core & Database Configuration
# ------------------------------------------------------------------------------
# Backend API port
PORT=8000

# Public frontend base URL (used for Magic Links, Password Reset emails, and invites)
APP_BASE_URL=http://localhost:3000

# Frontend API base URL (used by Vite React client in development)
VITE_API_URL=http://localhost:8000

# Local PostgreSQL container settings
POSTGRES_USER=choresync
POSTGRES_PASSWORD=choresync_secret
POSTGRES_DB=choresync
POSTGRES_PORT=5433

# PostgreSQL connection string
# Local host development:
DATABASE_URL=postgres://choresync:choresync_secret@localhost:5433/choresync?sslmode=disable
# Inside Docker Compose network:
# DATABASE_URL=postgres://choresync:choresync_secret@postgres:5432/choresync?sslmode=disable
# Remote Neon Serverless PostgreSQL (Production / Cloud):
# DATABASE_URL=postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 5. Message Queue & Asynchronous Workers
#    Supported providers:
#      - "neon"     : ACID-safe PostgreSQL queue (Recommended: 0 extra services, uses DATABASE_URL)
#      - "sqs"      : AWS SQS or local Floci emulator
#      - "mock"     : In-memory mock queue (offline dev)
# ------------------------------------------------------------------------------
QUEUE_PROVIDER=neon

# ------------------------------------------------------------------------------
# 6. Photo Proof & Object Storage
#    Supported providers:
#      - "cloudinary" : Cloudinary CDN & image storage (Recommended: 25GB free tier, zero AWS)
#      - "s3"         : AWS S3 / Cloudflare R2 / MinIO / Floci
#      - "mock"       : In-memory mock storage (offline dev)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=mock

# --- Option A: Cloudinary (Free 25GB/mo plan - https://cloudinary.com) ---
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=cloudinary://123456789:abcdefghijk@your-cloud-name
# Or individual keys:
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_FOLDER=choresync/proofs

# --- Option B: Local Cloud Emulator (Floci S3 & SQS) / AWS S3 ---
ENABLE_CLOUD_SERVICES=true
FLOCI_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Local host access:
AWS_ENDPOINT_URL=http://localhost:4566
# Inside Docker Compose network:
# AWS_ENDPOINT_URL=http://floci:4566
S3_BUCKET_NAME=choresync-proofs
SQS_QUEUE_NAME=choresync-reminders

# ------------------------------------------------------------------------------
# 6. Observability & OpenTelemetry (Full-Stack APM & LGTM Stack)
#    - Mandatory Telemetry Golden Triangle:
#        service.name, deployment.environment, service.version
# ------------------------------------------------------------------------------
# Backend OpenTelemetry Settings
OTEL_SERVICE_NAME=api-backend
DEPLOYMENT_ENVIRONMENT=development
SERVICE_VERSION=dev-latest
# Host collector endpoint (or http://observability-otel-collector:4318 in docker-compose)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional OTLP auth headers (e.g. for Grafana Cloud or Honeycomb: "api-key=xyz")
# OTEL_EXPORTER_OTLP_HEADERS=

# Frontend OpenTelemetry Settings (Vite React SPA)
VITE_OTEL_SERVICE_NAME=web-frontend
VITE_APP_ENV=development
VITE_APP_VERSION=dev-latest
VITE_OTEL_EXPORTER_URL=http://localhost:4318/v1/traces

# Standalone Observability Cluster Ports (make obs-up)
OTEL_HTTP_PORT=4318
OTEL_GRPC_PORT=4319       # Port 4319 avoids collision with host IDEs on 4317
OTEL_METRICS_PORT=8889
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ------------------------------------------------------------------------------
# 7. Autonomous Incident Response & On-Call Receiver
# ------------------------------------------------------------------------------
RECEIVER_PORT=5050
INCIDENTS_DIR=on-call-engineer/incidents

# ------------------------------------------------------------------------------
# 8. Production & Deployment Overrides (docker-compose.prod.yml / deploy.yml)
# ------------------------------------------------------------------------------
# PROD_PORT=8088
# PROD_POSTGRES_PORT=5434
# PROD_FLOCI_PORT=4567
# DEPLOY_FLOCI_PORT=4568
# PROD_OTEL_GRPC_PORT=4320
# PROD_OTEL_HTTP_PORT=4321
