{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityScanFindingsSchema",
  "description": "Strict JSON schema for security scan findings and human disposition records.",
  "type": "object",
  "required": [
    "scan_id",
    "timestamp",
    "scanner",
    "total_files_scanned",
    "summary",
    "findings"
  ],
  "properties": {
    "scan_id": {
      "type": "string",
      "description": "Unique identifier for the scan run (e.g. SCAN-20260928-001)"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of scan execution"
    },
    "scanner": {
      "type": "string",
      "description": "Name and version of scanning engine (e.g. Semgrep 1.177.0)"
    },
    "total_files_scanned": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of project files analyzed"
    },
    "summary": {
      "type": "object",
      "required": ["critical_count", "warning_count", "info_count"],
      "properties": {
        "critical_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "info_count": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "rule_id",
          "severity",
          "file_path",
          "line_number",
          "description",
          "cwe_id",
          "human_disposition",
          "disposition_by",
          "disposition_notes"
        ],
        "properties": {
          "finding_id": { "type": "string" },
          "rule_id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "ERROR", "WARNING", "INFO"]
          },
          "file_path": { "type": "string" },
          "line_number": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "cwe_id": { "type": "string" },
          "human_disposition": {
            "type": "string",
            "enum": ["open", "confirmed_vulnerability", "false_positive", "accepted_risk", "remediated"]
          },
          "disposition_by": { "type": "string" },
          "disposition_notes": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
